# Optional: override the backend API URL (must end with /api)
# VITE_API_URL=http://localhost:5000/api

# Google sign-in — same OAuth Client ID as GOOGLE_CLIENT_ID in backend/.env.
# Create one at https://console.cloud.google.com/apis/credentials (type: Web application,
# add http://localhost:5173 to "Authorized JavaScript origins").
# Leave unset to hide the Google button.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
