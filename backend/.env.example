PORT=5000
MONGO_URI=your_mongodb_connection_string
GEMINI_API_KEY=your_gemini_api_key

# Auth
JWT_SECRET=change_this_to_a_long_random_string

# Google sign-in (create an OAuth Client ID at https://console.cloud.google.com/apis/credentials)
# Use the same value in frontend/.env as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Email (OTP verification + budget warning emails)
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# Leave EMAIL_USER/EMAIL_PASS empty in dev to log emails to the console instead
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Expense Tracker" <you@gmail.com>
